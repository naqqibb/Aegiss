# APEX provider credentials — copy to a private, git-ignored location and fill in.
# APEX reads these from the process environment ONLY. Never commit real values.

# --- hunt.io (C2 Feed) --- https://apidocs.hunt.io/docs/c2-feed
HUNTIO_API_TOKEN=
# optional overrides
# HUNTIO_BASE_URL=https://api.hunt.io/v1
# HUNTIO_RATE=5

# --- Huntress (EDR incident reports) --- https://api.huntress.io/docs
HUNTRESS_API_KEY=
HUNTRESS_API_SECRET=
# optional overrides
# HUNTRESS_BASE_URL=https://api.huntress.io/v1
# HUNTRESS_RATE=5
